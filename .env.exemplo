# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O .env fica fora do GitHub (.gitignore): nunca coloque o token no código.

# Token que o @BotFather mostra ao criar o bot (formato 123456789:ABC...)
TELEGRAM_TOKEN=

# Seu chat_id. Para preencher sozinho: mande uma mensagem para o bot e rode
#   python telegram_bot.py --descobrir-chat-id
TELEGRAM_CHAT_ID=
